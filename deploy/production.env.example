# Environment for the single-container image (the root Dockerfile) on any host:
# Render, Railway, Fly.io, a VPS with `docker run --env-file`.
# Copy, fill in, and keep the real file out of git.
#
#   docker run -p 4000:4000 --env-file production.env shopos

NODE_ENV=production

# REQUIRED. A MongoDB replica set - MongoDB Atlas (any tier, free M0 included) is one.
# Atlas: Database -> Connect -> Drivers. Put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shopos?retryWrites=true&w=majority

# REQUIRED. Two different random values, 32+ characters each. Generate each with:
#   openssl rand -hex 64
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing either one signs everybody out (that is the point when one leaks).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Most hosts set PORT themselves; the image defaults to 4000.
# PORT=4000

# OPTIONAL. Google Sign-In. Add your deployed address (https://...) to the OAuth
# client's "Authorised JavaScript origins" in Google Cloud Console first.
GOOGLE_CLIENT_ID=

# OPTIONAL. Product images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only if another website (not this app) must call the API, comma separated.
# The app's own address is always allowed and does not need listing.
# CORS_ORIGINS=https://another-site.example.com

# Hourly overdue reminders. With several instances, true on exactly one.
JOBS_ENABLED=true

LOG_LEVEL=info

# Leave on: builds any missing database indexes (unique constraints) at startup.
# SYNC_INDEXES=true
