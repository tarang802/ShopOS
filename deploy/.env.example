# Copy to the repository root as .env before `docker compose up`.
# Generate each secret separately:  openssl rand -hex 64

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The address people use in the browser.
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Run background jobs (overdue reminders). Set to false on all but one API instance.
JOBS_ENABLED=true
LOG_LEVEL=info
