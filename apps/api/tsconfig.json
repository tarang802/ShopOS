{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    // tsup produces the build output, so tsc only ever type-checks. That also
    // means no rootDir constraint, which lets @shopos/shared be consumed as
    // TypeScript source rather than as a pre-built package.
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
