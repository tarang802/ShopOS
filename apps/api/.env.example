# ---------------------------------------------------------------------------
# ShopOS API environment
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# MongoDB connection string.
# Local replica set:  mongodb://127.0.0.1:27017/shopos?replicaSet=rs0
# Atlas:              mongodb+srv://user:pass@cluster.mongodb.net/shopos
MONGODB_URI=mongodb://127.0.0.1:27017/shopos

# Auth secrets (Phase 3). Generate with:  openssl rand -hex 64
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cloudinary (Phase 6 - product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
