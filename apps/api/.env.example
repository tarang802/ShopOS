# ---------------------------------------------------------------------------
# ShopOS API environment
#
# Copy to .env and fill in real values. NEVER commit .env - it is gitignored.
# Only MONGODB_URI is required to start in development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# REQUIRED - MongoDB
# ---------------------------------------------------------------------------
# A replica set is required for stock transfers and adjustments to be atomic.
# Local single-node replica set:
#   MONGODB_URI=mongodb://127.0.0.1:27017/shopos?replicaSet=rs0
# MongoDB Atlas (already a replica set):
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shopos
MONGODB_URI=mongodb://127.0.0.1:27017/shopos

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION - token signing
# ---------------------------------------------------------------------------
# Generate each one separately. They must differ from each other.
#   openssl rand -hex 64
# In development these may be left as-is; production boot fails if they are.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Set only when the API and the web app sit on different registrable domains.
# COOKIE_DOMAIN=.yourdomain.com

# ---------------------------------------------------------------------------
# OPTIONAL - Google Sign-In
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
#   Create Credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origins: http://localhost:5173
# Leave blank and the app quietly hides the Google button; password login works.
# The same client id also goes into apps/web/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL - Cloudinary, for product images
# ---------------------------------------------------------------------------
# From https://console.cloudinary.com -> Dashboard.
# Leave blank and image upload is disabled; everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
